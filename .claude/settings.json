{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/install-skills.sh\" >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 300,
            "statusMessage": "Installing agent skills"
          }
        ]
      }
    ]
  }
}
